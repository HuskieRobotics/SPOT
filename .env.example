# SPOT reads settings from environment variables AND/OR config/config.json.
# Environment variables win when both are set. Copy to .env.local (Next.js loads it automatically).

# Required: MongoDB connection string (MongoDB Atlas recommended). MONGODB_URI is accepted as an alias.
DATABASE_URL=mongodb://127.0.0.1:27017/spot

# Admin password. Leave empty to disable admin sign-in (NOT recommended on a public server).
ACCESS_CODE=change-me

# The Blue Alliance read API key (https://www.thebluealliance.com/account)
TBA_API_KEY=

# Default event settings (can also be changed later from Admin > Settings)
TBA_EVENT_KEY=2026mnwi
# Event code stored in the database, "<tba key>_<label>". Created automatically if missing.
EVENT_CODE=2026mnwi_official
# true flips zone buttons / field map to match where your team sits
SWAP_ZONE_BUTTON_LOCATIONS=false
# Comma-separated TBA component-OPR names to attach to teams as opr.<name>
TBA_OPR_STRINGS=Hub Total Fuel Count,minorFoulCount,majorFoulCount
DEMO=false

# Optional: secret used to sign admin session cookies (defaults to a hash of ACCESS_CODE)
SESSION_SECRET=
# Optional: alternate location of config.json
CONFIG_PATH=
