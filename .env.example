# SPOT v6 — environment variables (copy to .env.local for development)
# Secrets live here, never in committed files (docs/spec/12, R-32).

# MongoDB Atlas connection string (all deployments)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Password for admin/edit/setup/schedule pages
SPOT_ADMIN_PASSWORD=change-me

# The Blue Alliance read API key (https://www.thebluealliance.com/account)
TBA_API_KEY=

# Port for `next start` (EC2 behind nginx; Cloud Run sets PORT itself)
PORT=3000
