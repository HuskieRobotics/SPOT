{
  "$schema": "../src/config/schema/match-scouting.schema.json",
  "version": 2,
  "timing": {
    "totalMs": 160000,
    "phases": [
      {
        "id": "auto",
        "label": "Auto",
        "startMs": 159999,
        "layer": "layer-1",
        "prefix": "auto"
      },
      {
        "id": "teleopTransition",
        "label": "Teleop Transition",
        "startMs": 140000,
        "layer": "layer-7",
        "prefix": "teleopTransition"
      },
      {
        "id": "teleop",
        "label": "Teleop",
        "startMs": 130000,
        "layer": "layer-2",
        "prefix": "teleop"
      }
    ],
    "endgame": {
      "startMs": 30000,
      "prefix": "endgame",
      "label": "Endgame"
    },
    "shifts": {
      "intervalMs": 25000,
      "startMs": 130000,
      "endMs": 30000,
      "maxIndex": 4,
      "kinds": [
        {
          "id": "active",
          "prefix": "activeShift",
          "toggleButton": "teleopActive"
        },
        {
          "id": "inactive",
          "prefix": "inactiveShift",
          "toggleButton": "teleopInactive"
        }
      ]
    }
  },
  "idPrefixing": "phase",
  "variables": {},
  "rules": {
    "undo": {
      "minQueueLength": 2
    },
    "positionLockMs": 1000,
    "locks": [
      {
        "id": "aStop",
        "triggerButtons": ["aStop"],
        "untilPhase": "teleopTransition",
        "exemptTypes": ["undo", "match-control"],
        "message": "You pressed the A-Stop button, all the buttons will be disabled until Auto ends. If this is a mistake then press the Undo button"
      }
    ],
    "allianceRelativeButtons": [
      {
        "own": "AZone",
        "opposing": "OAZone"
      }
    ],
    "fieldMap": {
      "image": "/img/field.svg"
    }
  },
