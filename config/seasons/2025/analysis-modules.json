{
  "$schema": "../../../src/config/schema/analysis-modules.schema.json",
  "version": 2,
  "modules": [
    {
      "view": "team",
      "module": "PerformanceTimePlot",
      "name": "Performance By Each Match",
      "options": {
        "trackedStats": ["scores.auto", "scores.teleop", "scores.endgame", "scores.total"]
      },
      "position": "main"
    },
    {
      "view": "team",
      "module": "Pie",
      "name": "Coral Pickup Distribution",
      "options": {
        "slices": [
          {
            "name": "Ground",
            "path": "counts.groundPickupCoral"
          },
          {
            "name": "Station",
            "path": "counts.stationPickupCoral"
          }
        ]
      },
      "position": "main"
    },
    {
      "view": "team",
      "module": "Pie",
      "name": "Algae Pickup Distribution",
      "options": {
        "slices": [
          {
            "name": "Ground",
            "path": "counts.groundPickupAlgae"
          },
          {
            "name": "Reef",
            "path": "counts.reefPickupAlgae"
          }
        ]
      },
      "position": "main"
    },
    {
      "view": "team",
      "module": "Pie",
      "name": "Teleop Algae Scored Distribution",
      "options": {
        "slices": [
          {
            "name": "Net",
            "path": "counts.teleopScoreNet"
          },
          {
            "name": "Processor",
            "path": "counts.teleopScoreProcessor"
          }
        ]
      },
      "position": "main"
    },
    {
      "view": "team",
      "module": "Pie",
      "name": "Auto Algae Scored Distribution",
      "options": {
        "slices": [
          {
            "name": "Net",
            "path": "counts.autoScoreNet"
          },
          {
            "name": "Processor",
            "path": "counts.autoScoreProcessor"
          }
        ]
      },
      "position": "main"
    },
    {
      "view": "team",
      "module": "Bar",
      "name": "Coral Reef Placement",
      "options": {
        "bars": [
          {
            "name": "Miss",
            "path": "counts.missCoral"
          },
          {
            "name": "Level 1",
            "path": "counts.scoreL1"
          },
          {
            "name": "Level 2",
            "path": "counts.scoreL2"
          },
          {
            "name": "Level 3",
            "path": "counts.scoreL3"
          },
          {
            "name": "Level 4",
            "path": "counts.scoreL4"
          }
        ]
      },
      "position": "main"
    },
    {
      "view": "team",
      "module": "Bar",
      "name": "Auto Coral Reef Placement",
      "options": {
        "bars": [
          {
            "name": "Miss",
            "path": "counts.autoMissCoral"
          },
          {
            "name": "Level 1",
            "path": "counts.autol1"
          },
          {
            "name": "Level 2",
            "path": "counts.autol2"
          },
          {
            "name": "Level 3",
            "path": "counts.autol3"
          },
          {
            "name": "Level 4",
            "path": "counts.autol4"
          }
        ]
      },
      "position": "main"
    },
    {
      "view": "team",
      "module": "Bar",
      "name": "Barge",
      "options": {
        "bars": [
          {
            "name": "Park",
            "path": "counts.park"
          },
          {
            "name": "Fall",
            "path": "counts.bargeFall"
          },
          {
            "name": "Deep Cage",
            "path": "counts.deep"
          },
          {
            "name": "Shallow Cage",
            "path": "counts.shallow"
          }
        ]
      },
      "position": "main"
    },
    {
      "view": "team",
      "module": "Bar",
      "name": "Auto Pickup Distribution",
      "options": {
        "bars": [
          {
            "name": "Algae Left",
            "path": "counts.autoAlgaeLeft"
          },
          {
            "name": "Algae Center",
            "path": "counts.autoAlgaeCenter"
          },
          {
            "name": "Algae Right",
            "path": "counts.autoAlgaeRight"
          },
          {
            "name": "Coral Left",
            "path": "counts.autoCoralLeft"
          },
          {
            "name": "Coral Center",
            "path": "counts.autoCoralCenter"
          },
          {
            "name": "Coral Right",
            "path": "counts.autoCoralRight"
          }
        ]
      },
      "position": "main"
    },
    {
      "view": "team",
      "module": "Pie",
      "name": "Pre-Loads",
      "options": {
        "slices": [
          {
            "name": "Pre-Loaded Coral",
            "path": "counts.preloadCoral"
          },
          {
            "name": "Pre-Load None",
            "path": "counts.preloadNone"
          }
        ]
      },
      "position": "main"
    },
    {
      "view": "team",
      "module": "Stats",
      "name": "Team Stats",
      "options": {
        "list": [
          {
            "name": "Algae Accuracy",
            "path": "algaeAccuracy",
            "multiplier": 100,
            "decimals": 2,
            "sort": 1,
            "unit": "%"
          },
          {
            "name": "Coral Accuracy",
            "path": "coralAccuracy",
            "multiplier": 100,
            "decimals": 2,
            "sort": 1,
            "unit": "%"
          },
          {
            "name": "Average Cycle Time",
            "path": "timePerGamePiece",
            "multiplier": 0.001,
            "decimals": 2,
            "hideIfValue": 0,
            "sort": -1,
            "unit": "s"
          },
          {
            "name": "Algae Time to Score",
            "path": "cycles.algae.averageTime",
            "multiplier": 0.001,
            "decimals": 2,
            "hideIfValue": 0,
            "sort": -1,
            "unit": "s"
          },
          {
            "name": "Coral Time to Score",
            "path": "cycles.coral.averageTime",
            "multiplier": 0.001,
            "decimals": 2,
            "hideIfValue": 0,
            "sort": -1,
            "unit": "s"
          },
          {
            "name": "Average Time to Climb",
            "path": "cycles.endgame.averageTimeComplete",
            "multiplier": 0.001,
            "decimals": 2,
            "hideIfValue": 0,
            "sort": -1,
            "unit": "s"
          },
          {
            "name": "Average Auto Points",
            "path": "averageScores.auto",
            "decimals": 2,
            "sort": 1
          },
          {
            "name": "Average Teleop Points",
            "path": "averageScores.teleop",
            "decimals": 2,
            "sort": 1
          },
          {
            "name": "Average Barge Points",
            "path": "averageScores.endgame",
            "decimals": 2,
            "sort": 1
          },
          {
            "name": "Average Algae Points",
            "path": "averageScores.algae",
            "decimals": 2,
            "sort": 1
          },
          {
            "name": "Average Coral Points",
            "path": "averageScores.coral",
            "decimals": 2,
            "sort": 1
          },
          {
            "name": "Average Points",
            "path": "averageScores.total",
            "decimals": 2,
            "sort": 1
          },
          {
            "name": "Average Coral Misses",
            "path": "averages.missCoral",
            "decimals": 2,
            "sort": -1
          },
          {
            "name": "Average Algae Misses",
            "path": "averages.missAlgae",
            "decimals": 2,
            "sort": -1
          },
          {
            "name": "Average Coral Drops",
            "path": "averages.dropCoral",
            "decimals": 2,
            "sort": -1
          },
          {
            "name": "Average Algae Drops",
            "path": "averages.dropAlgae",
            "decimals": 2,
            "sort": -1
          },
          {
            "name": "Leave",
            "path": "averages.leave",
            "multiplier": 100,
            "decimals": 2,
            "sort": 1,
            "unit": "%"
          },
          {
            "name": "Total Brokens",
            "path": "counts.broken",
            "decimals": 0,
            "sort": -1
          },
          {
            "name": "Total A-Stops",
            "path": "counts.aStop",
            "decimals": 0,
            "sort": -1
          }
        ]
      },
      "position": "side"
    },
    {
      "view": "match",
      "module": "SingleDisplay",
      "name": "Alliance Score",
      "options": {
        "path": "averageScores.total",
        "aggrMethod": "sum",
        "decimals": 2
      },
      "position": "main"
    },
    {
      "view": "match",
      "module": "ColumnDisplay",
      "name": "Average Cycle Time",
      "options": {
        "path": "timePerGamePiece",
        "multiplier": 0.001,
        "decimals": 2,
        "hideIfValue": 0,
        "sort": -1,
        "unit": "s"
      },
      "position": "main"
    },
    {
      "view": "match",
      "module": "ColumnDisplay",
      "name": "Auto Points",
      "options": {
        "path": "averageScores.auto",
        "sort": 1,
        "decimals": 2
      },
      "position": "main"
    },
    {
      "view": "match",
      "module": "ColumnDisplay",
      "name": "Teleop Points",
      "options": {
        "path": "averageScores.teleop",
        "sort": 1,
        "decimals": 2
      },
      "position": "main"
    },
    {
      "view": "match",
      "module": "ColumnDisplay",
      "name": "Barge Points",
      "options": {
        "path": "avgEndgamePoints",
        "sort": 1,
        "decimals": 2
      },
      "position": "main"
    },
    {
      "view": "match",
      "module": "ColumnDisplay",
      "name": "Total Points",
      "options": {
        "path": "averageScores.total",
        "sort": 1,
        "decimals": 2
      },
      "position": "main"
    },
    {
      "view": "match",
      "module": "Stats",
      "name": "Alliance Stats",
      "options": {
        "list": [
          {
            "name": "Expected Auto Points",
            "path": "averageScores.auto",
            "decimals": 2,
            "aggrMethod": "sum"
          },
          {
            "name": "Expected Teleop Points",
            "path": "averageScores.teleop",
            "decimals": 2,
            "aggrMethod": "sum"
          },
          {
            "name": "Expected Barge Points",
            "path": "avgEndgamePoints",
            "decimals": 2,
            "aggrMethod": "sum"
          },
          {
            "name": "Expected Score",
            "path": "averageScores.total",
            "decimals": 2,
            "aggrMethod": "sum"
          }
        ]
      },
      "position": "side"
    }
  ],
  "filterTeams": {
    "ratingBands": [
      {
        "id": "Rating4",
        "label": "Rating4",
        "kind": "exact",
        "value": 4
      },
      {
        "id": "Rating3",
        "label": "Rating3",
        "kind": "min",
        "value": 3
      },
      {
        "id": "Rating2",
        "label": "Rating2",
        "kind": "min",
        "value": 2
      },
      {
        "id": "Rating1",
        "label": "Rating1",
        "kind": "min",
        "value": 1
      },
      {
        "id": "eliteOPR",
        "label": "Elite OPR (250+)",
        "kind": "min",
        "value": 250
      },
      {
        "id": "strongOPR",
        "label": "Strong OPR (151-250)",
        "kind": "range",
        "min": 151,
        "max": 250
      },
      {
        "id": "decentOPR",
        "label": "Decent OPR (101-150)",
        "kind": "range",
        "min": 101,
        "max": 150
      },
      {
        "id": "lowOPR",
        "label": "Low OPR (0-100)",
        "kind": "range",
        "min": 0,
        "max": 100
      },
      {
        "id": "negativeOPR",
        "label": "Negative OPR",
        "kind": "negative"
      }
    ]
  }
}
