{
  "$schema": "../src/config/schema/analysis-pipeline.schema.json",
  "version": 2,
  "enrichment": {
    "tba": {
      "scoreBreakdown": {
        "enabled": true,
        "prefixes": [
          {
            "prefix": "auto",
            "phase": "auto"
          },
          {
            "prefix": "endGame",
            "phase": "endgame"
          }
        ],
        "knownIds": [
          "autoTowerRobot_Level1",
          "endGameTowerRobot_Level1",
          "endGameTowerRobot_Level2",
          "endGameTowerRobot_Level3"
        ]
      },
      "componentOprs": ["Hub Total Fuel Count", "minorFoulCount", "majorFoulCount"]
    }
  },
  "pipeline": [
    {
      "type": "tmp",
      "name": "countActions",
      "outputPath": "counts",
      "options": {
        "all": true,
        "by": "segment"
      }
    },
    {
      "type": "tmp",
      "name": "sum",
      "outputPath": "counts.shooting",
      "options": {
        "addends": [
          "counts.auto.StopShooting",
          "counts.transition.StopShooting",
          "counts.active1.StopShooting",
          "counts.active2.StopShooting",
          "counts.inactive1.StopShooting",
          "counts.inactive2.StopShooting",
          "counts.endgame.StopShooting"
        ]
      }
    },
    {
      "type": "tmp",
      "name": "sum",
      "outputPath": "counts.passing",
      "options": {
        "addends": [
          "counts.auto.Passing",
          "counts.transition.Passing",
          "counts.active1.Passing",
          "counts.active2.Passing",
          "counts.inactive1.Passing",
          "counts.inactive2.Passing",
          "counts.endgame.Passing"
        ]
      }
    },
    {
      "type": "tmp",
      "name": "sum",
      "outputPath": "counts.storing",
      "options": {
        "addends": [
          "counts.transition.Storing",
          "counts.active1.Storing",
          "counts.active2.Storing",
          "counts.inactive1.Storing",
          "counts.inactive2.Storing",
          "counts.endgame.Storing"
        ]
      }
    },
    {
      "type": "tmp",
      "name": "sum",
      "outputPath": "counts.defense",
      "options": {
        "addends": [
          "counts.transition.Defense",
          "counts.active1.Defense",
          "counts.active2.Defense",
          "counts.inactive1.Defense",
          "counts.inactive2.Defense",
          "counts.endgame.Defense"
        ]
      }
    },
    {
      "type": "tmp",
      "name": "actionTime",
      "outputPath": "actionTimes.attemptClimb",
      "options": {
        "actionId": ["attemptClimb"]
      }
    },
    {
      "type": "tmp",
      "name": "cycle",
      "outputPath": "cycle.autoShootingTime",
      "options": {
        "startAction": ["StartShooting"],
        "endAction": ["StopShooting"],
        "phases": ["auto"]
      }
    },
    {
      "type": "tmp",
      "name": "cycle",
      "outputPath": "cycle.shootingTime",
      "options": {
        "startAction": ["StartShooting"],
        "endAction": ["StopShooting"],
        "phases": ["teleop", "endgame"]
      }
    },
    {
      "type": "tmp",
      "name": "cycle",
      "outputPath": "cycle.defenseTime",
      "options": {
        "startAction": ["Defense"],
        "endAction": ["RatingDefense1", "RatingDefense2", "RatingDefense3", "RatingDefense4"],
        "phases": ["teleop", "endgame"]
      }
    },
    {
      "type": "tmp",
      "name": "cycle",
      "outputPath": "cycle.storingTime",
      "options": {
        "startAction": ["Storing"],
        "endAction": ["RatingStoring1", "RatingStoring2", "RatingStoring3", "RatingStoring4"],
        "phases": ["teleop", "endgame"]
      }
    },
    {
      "type": "tmp",
      "name": "cycle",
      "outputPath": "cycle.passingTime",
      "options": {
        "startAction": ["Passing"],
        "endAction": ["RatingPassing1", "RatingPassing2", "RatingPassing3", "RatingPassing4"],
        "phases": ["auto", "teleop", "endgame"]
      }
    },
    {
      "type": "tmp",
      "name": "weightedSumAverage",
      "outputPath": "scores.autoPassingRating",
      "options": {
        "weightedPaths": {
          "counts.auto.RatingPassing1": 1,
          "counts.auto.RatingPassing2": 2,
          "counts.auto.RatingPassing3": 3,
          "counts.auto.RatingPassing4": 4
        }
      }
    },
    {
      "type": "tmp",
      "name": "weightedSumAverage",
      "outputPath": "scores.autoShootingRating",
      "options": {
        "weightedPaths": {
          "counts.auto.RatingShooting1": 1,
          "counts.auto.RatingShooting2": 2,
          "counts.auto.RatingShooting3": 3,
