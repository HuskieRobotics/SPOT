{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "SPOT dev server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "outputCapture": "std"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "SPOT in Chrome",
      "url": "http://localhost:8080"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "SPOT tests",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["test"],
      "outputCapture": "std"
    }
  ]
}
