{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spot.team3061.org/schema/v2/tba-data.schema.json",
  "title": "SPOT TBA data for an event (data model v2)",
  "description": "What The Blue Alliance last said about an event, for analysis: its matches with score breakdowns, component OPRs and team names. One document per event (DV-19, F-6), so the dashboard keeps working while TBA cannot be reached.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_id", "tenantId", "eventId", "tbaKey", "matches", "coprs", "teams", "fetchedAt"],
  "properties": {
    "_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$",
      "description": "The event id: one document per event."
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "eventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$"
    },
    "tbaKey": {
      "type": "string",
      "minLength": 1
    },
    "matches": {
      "type": "array",
      "description": "TBA's /event/{key}/matches, keeping only what enrichment reads (DM-11a).",
      "items": {
        "$ref": "#/$defs/match"
      }
    },
    "coprs": {
      "type": "object",
      "description": "TBA's /event/{key}/coprs: { \"<component>\": { \"frc3061\": value } } (DM-13a).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "number"
        }
      }
    },
    "teams": {
      "type": "array",
      "description": "The event's teams with TBA's nicknames (AN-12).",
      "items": {
        "$ref": "#/$defs/team"
      }
    },
    "fetchedAt": {
      "type": "integer",
      "minimum": 0,
      "description": "When TBA was last read, epoch ms; read again after five minutes (NF-6)."
    }
  },
  "$defs": {
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comp_level", "match_number", "alliances"],
      "properties": {
        "comp_level": {
          "type": "string"
        },
        "match_number": {
          "type": "integer",
          "minimum": 0
        },
        "alliances": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["team_keys"],
            "properties": {
              "team_keys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "score_breakdown": {
          "type": ["object", "null"],
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team", "nickname"],
      "properties": {
        "team": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,4}[A-Z]?$"
        },
        "nickname": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
