{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spot.team3061.org/schema/v2/analysis-pipeline.schema.json",
  "title": "SPOT analysis-pipeline configuration (v2)",
  "description": "Ordered list of transformer instances plus TBA enrichment settings. Built-in transformer options are validated strictly (unknown keys are errors). An extension transformer's options are not checked here, because its name is not known here; the transformer registry checks them against the extension's own schema (docs/spec/09 TR-14). See docs/spec/09 and docs/spec/20.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "enrichment", "pipeline"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 2
    },
    "enrichment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tba"],
      "properties": {
        "tba": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scoreBreakdown", "componentOprs"],
          "properties": {
            "scoreBreakdown": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "prefixes"],
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Add actions from each match's TBA score breakdown."
                },
                "prefixes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["prefix", "phase"],
                    "properties": {
                      "prefix": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Score-breakdown keys starting with this, such as \"endGame\"."
                      },
                      "phase": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Phase id from match-scouting.json that the actions belong to, such as \"endgame\"."
                      }
                    }
                  },
                  "description": "Each score-breakdown key that starts with a prefix and ends with the robot's slot (1-3) becomes an action \"<key without the slot>_<value>\" in that prefix's phase, such as endGameTowerRobot_Level2."
                },
                "knownIds": {
                  "$ref": "#/$defs/idList",
                  "description": "Score-breakdown action ids that countActions(all) starts at 0 in every match, such as \"endGameTowerRobot_Level3\", so a module shows 0 rather than No Data at an event where nobody did it. Ids TBA reports anywhere at the event start at 0 without being listed here."
                }
              }
            },
            "componentOprs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "TBA component-OPR names, attached to each team as opr.<name> (null when TBA has none)."
            }
          }
        }
      }
    },
    "pipeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$",
      "description": "Dot-separated object path (no leading/trailing whitespace)."
    },
    "pathList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "pathOrNumberList": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/path"
          },
          {
            "type": "number"
          }
        ]
      }
    },
    "idList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actionId": {
      "type": "string",
      "minLength": 1,
      "description": "A button id from match-scouting.json, an id from its extraActionIds, or a TBA score-breakdown id such as endGameTowerRobot_Level3. config:check reports an id that is none of these."
    },
    "actionIdList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actionId"
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "outputPath"],
      "properties": {
        "type": {
          "enum": ["tmp", "team"]
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "outputPath": {
          "$ref": "#/$defs/path"
        },
        "options": {
          "type": "object"
        },
        "comment": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "name": {
                "const": "countActions"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/countActions"
              }
            },
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "sum"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/sum"
              }
            },
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "subtract"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/subtract"
              }
            },
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "multiply"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/multiply"
              }
            },
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "ratio"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/ratio"
              }
            },
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "weightedSum"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/weightedSum"
              }
            },
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "weightedSumAverage"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/weightedSumAverage"
              }
            },
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "sumAverage"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/sumAverage"
              }
            },
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "average"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/average"
              }
            },
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "averageTime"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/average"
              }
            },
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "deepAverage"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/pathOnly"
              }
            },
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "aggregateArray"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/pathOnly"
              }
            },
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "standardDeviation"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/pathOnly"
              }
            },
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "averageArray"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/averageArray"
              }
            },
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "countMatches"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/countMatches"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "actionTime"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/actionTime"
              }
            },
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "actionTimeFilter"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/actionTimeFilter"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "finalActionOccurrence"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/finalActionOccurrence"
              }
            },
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "map"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/map"
              }
            },
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "cycle"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/cycle"
              }
            },
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "countHybrid"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/countHybrid"
              }
            },
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "threshold"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/threshold"
              }
            },
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "zoneActionRatingGroupings"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/options/zoneActionRatingGroupings"
              }
            },
            "required": ["options"]
          }
        }
      ]
    },
    "options": {
      "countActions": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "all": {
            "type": "boolean",
            "description": "Count every action. Every action button starts at 0; ids the configuration does not know are counted too."
          },
          "ids": {
            "$ref": "#/$defs/actionIdList",
            "description": "Count only these button ids, each starting at 0."
          },
          "actionArrayPath": {
            "$ref": "#/$defs/path",
            "description": "Path to the list of actions to count. Default: actions."
          },
          "phases": {
            "$ref": "#/$defs/periodFilter/properties/phases"
          },
          "segments": {
            "$ref": "#/$defs/periodFilter/properties/segments"
          },
          "kinds": {
            "$ref": "#/$defs/periodFilter/properties/kinds"
          },
          "by": {
            "enum": ["phase", "segment"],
            "description": "Split the counts by period: by phase (auto, teleop, endgame, preMatch) or by the most specific period (transition, active1, ...)."
          }
        },
        "anyOf": [
          {
            "required": ["all"]
          },
          {
            "required": ["ids"]
          }
        ]
      },
      "sum": {
        "type": "object",
        "additionalProperties": false,
        "required": ["addends"],
        "properties": {
          "addends": {
            "$ref": "#/$defs/pathList",
            "description": "Paths to add. A missing path counts as 0; a null value makes the result null."
          }
        }
      },
      "subtract": {
        "type": "object",
        "additionalProperties": false,
        "required": ["minuend", "subtrahend"],
        "properties": {
          "minuend": {
            "$ref": "#/$defs/path",
            "description": "Path to the value to subtract from. Missing counts as 0."
          },
          "subtrahend": {
            "$ref": "#/$defs/path",
            "description": "Path to the value to subtract. Missing counts as 0."
          }
        }
      },
      "multiply": {
        "type": "object",
        "additionalProperties": false,
        "required": ["multiplicands", "weight"],
        "properties": {
          "multiplicands": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/path"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path"],
                  "properties": {
                    "path": {
                      "$ref": "#/$defs/path"
                    }
                  }
                }
              ]
            },
            "description": "Paths to multiply. A missing path counts as 1; a null value makes the result null."
          },
          "weight": {
            "type": "number",
            "description": "Number to multiply the product by, such as 0.001 to turn milliseconds into seconds."
          }
        }
      },
      "ratio": {
        "type": "object",
        "additionalProperties": false,
        "required": ["numerator", "denominator"],
        "properties": {
          "numerator": {
            "$ref": "#/$defs/pathOrNumberList",
            "description": "Paths or numbers added together for the top of the fraction."
          },
          "denominator": {
            "$ref": "#/$defs/pathOrNumberList",
            "description": "Paths or numbers added together for the bottom of the fraction."
          },
          "divByZero": {
            "description": "Value to write when the denominator is 0, exactly as given (0 included). Leave it out to write null (\"No Data\"), which keeps the team out of rankings; set the worst value (0 accuracy, the full match time) to rank a team that never scores last."
          }
        }
      },
      "weightedSum": {
        "type": "object",
        "additionalProperties": false,
        "required": ["weightedPaths"],
        "properties": {
          "weightedPaths": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "description": "{ path: weight }: each value is multiplied by its weight, such as points per game piece, then added."
          }
        }
      },
      "weightedSumAverage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["weightedPaths"],
        "properties": {
          "weightedPaths": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "description": "{ path: weight }. The result is Σ(value × weight) / Σvalue, the average rating from rating counts for example; null when every value is 0."
          }
        }
      },
      "sumAverage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["groups"],
        "properties": {
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["averagePath", "countPaths"],
              "properties": {
                "averagePath": {
                  "$ref": "#/$defs/path",
                  "description": "Path to one average, such as an average rating."
                },
                "countPaths": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/path"
                  },
                  "description": "Paths to the counts that average was taken over; their total is the average's weight."
                }
              }
            }
          }
        }
      },
      "pathOnly": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          }
        }
      },
      "averageArray": {
        "type": "object",
        "additionalProperties": false,
        "required": ["arrayPath", "valuePath"],
        "properties": {
          "arrayPath": {
            "$ref": "#/$defs/path",
            "description": "Path to the list to average over."
          },
          "valuePath": {
            "$ref": "#/$defs/path",
            "description": "Path to the number on each item of the list. Items with no value are skipped."
          },
          "ifNone": {
            "description": "Value to write when there is nothing to average (the team never did it), exactly as given. Leave it out to write null (\"No Data\"), which keeps the team out of rankings; set the worst value, such as the full match time for a cycle time, to rank such a team last."
          }
        }
      },
      "countMatches": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "weight": {
            "type": "number",
            "description": "Multiply the number of matches by this (default 1)."
          }
        }
      },
      "actionTime": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actionId"],
        "properties": {
          "actionId": {
            "anyOf": [
              {
                "$ref": "#/$defs/actionId"
              },
              {
                "$ref": "#/$defs/actionIdList"
              }
            ],
            "description": "Button id, or a list of them: the time of the first action with any of these ids is written."
          },
          "default": {
            "description": "Value to write when no such action was recorded. Default: null."
          },
          "phases": {
            "$ref": "#/$defs/periodFilter/properties/phases"
          },
          "segments": {
            "$ref": "#/$defs/periodFilter/properties/segments"
          },
          "kinds": {
            "$ref": "#/$defs/periodFilter/properties/kinds"
          }
        }
      },
      "actionTimeFilter": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "timeMin": {
            "type": "number",
            "description": "Keep actions recorded with at least this much match time remaining (ms). Default: 0."
          },
          "timeMax": {
            "type": "number",
            "description": "Keep actions recorded with at most this much match time remaining (ms). Default: the match length."
          },
          "phases": {
            "$ref": "#/$defs/periodFilter/properties/phases"
          },
          "segments": {
            "$ref": "#/$defs/periodFilter/properties/segments"
          },
          "kinds": {
            "$ref": "#/$defs/periodFilter/properties/kinds"
          }
        }
      },
      "finalActionOccurrence": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ids"],
        "properties": {
          "ids": {
            "$ref": "#/$defs/actionIdList",
            "description": "The last action with any of these button ids is written."
          },
          "default": {
            "description": "Value to write when no such action was recorded. Default: null."
          },
          "actionArrayPath": {
            "$ref": "#/$defs/path",
            "description": "Path to the list of actions to search. Default: actions."
          },
          "phases": {
            "$ref": "#/$defs/periodFilter/properties/phases"
          },
          "segments": {
            "$ref": "#/$defs/periodFilter/properties/segments"
          },
          "kinds": {
            "$ref": "#/$defs/periodFilter/properties/kinds"
          }
        }
      },
      "map": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "map"],
        "properties": {
          "path": {
            "$ref": "#/$defs/path",
            "description": "Path to the value to translate."
          },
          "map": {
            "type": "object",
            "description": "{ value: result }: the table to translate through. A value not in the table gives null."
          }
        }
      },
      "cycle": {
        "type": "object",
        "description": "Period filters: pairing always runs over the whole match; a filter keeps the cycles that start or end in the period (TR-13).",
        "additionalProperties": false,
        "required": ["startAction", "endAction"],
        "properties": {
          "startAction": {
            "$ref": "#/$defs/actionIdList",
            "description": "Button ids that start a cycle, such as a pickup."
          },
          "endAction": {
            "$ref": "#/$defs/actionIdList",
            "description": "Button ids that end a cycle, such as a score."
          },
          "misses": {
            "$ref": "#/$defs/actionIdList",
            "description": "Button ids that end a cycle without success; such cycles are left out of allComplete."
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "description": "How many starts can be open at once: how many of these game pieces a robot can hold. Default 1. An end pairs with the newest open start; a start beyond the capacity drops the oldest open one."
          },
          "phases": {
            "$ref": "#/$defs/periodFilter/properties/phases"
          },
          "segments": {
            "$ref": "#/$defs/periodFilter/properties/segments"
          },
          "kinds": {
            "$ref": "#/$defs/periodFilter/properties/kinds"
          }
        }
      },
      "countHybrid": {
        "type": "object",
        "description": "Period filters: pairing always runs over the whole match; a filter counts a placement when it or its pickup is in the period (TR-13).",
        "additionalProperties": false,
        "required": ["pickup", "hybrid"],
        "properties": {
          "pickup": {
            "$ref": "#/$defs/actionIdList",
            "description": "Button ids that pick up a game piece; the result has one count per id."
          },
          "hybrid": {
            "$ref": "#/$defs/actionIdList",
            "description": "Button ids that place a game piece; each is counted under the piece last picked up."
          },
          "actionArrayPath": {
            "$ref": "#/$defs/path",
            "description": "Path to the list of actions to walk. Default: actions."
          },
          "phases": {
            "$ref": "#/$defs/periodFilter/properties/phases"
          },
          "segments": {
            "$ref": "#/$defs/periodFilter/properties/segments"
          },
          "kinds": {
            "$ref": "#/$defs/periodFilter/properties/kinds"
          }
        }
      },
      "threshold": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paths"],
        "properties": {
          "paths": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "{ path: name }: the names whose value passes are listed."
          },
          "threshold": {
            "type": "number",
            "description": "A value must be greater than this to pass. Leave it out to list every name."
          },
          "separator": {
            "type": "string",
            "description": "Join the names into one string with this separator. Leave it out for a list."
          },
          "none": {
            "type": "string",
            "description": "With a separator: the text to write when no name passes."
          }
        }
      },
      "zoneActionRatingGroupings": {
        "type": "object",
        "description": "Period filters: pairing always runs over the whole match; a filter keeps the triples whose zone or rating is in the period (TR-13).",
        "additionalProperties": false,
        "required": ["zones", "actions", "ratings"],
        "properties": {
          "zones": {
            "$ref": "#/$defs/actionIdList",
            "description": "Zone button ids. Each becomes a key of the output, so \"list\" and \"counts\" cannot be used."
          },
          "actions": {
            "$ref": "#/$defs/actionIdList",
            "description": "Action button ids, each paired with the zone pressed before it."
          },
          "ratings": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number"
            },
            "description": "{ ratingButtonId: value }: the rating buttons and the value each one stands for, such as { \"RatingPassing3\": 3 }.",
            "propertyNames": {
              "$ref": "#/$defs/actionId"
            }
          },
          "phases": {
            "$ref": "#/$defs/periodFilter/properties/phases"
          },
          "segments": {
            "$ref": "#/$defs/periodFilter/properties/segments"
          },
          "kinds": {
            "$ref": "#/$defs/periodFilter/properties/kinds"
          }
        }
      },
      "average": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {
            "$ref": "#/$defs/path",
            "description": "Path to a number, or an object of numbers, on each match. Matches with no value are skipped."
          },
          "ifNone": {
            "description": "Value to write when there is nothing to average (the team never did it), exactly as given. Leave it out to write null (\"No Data\"), which keeps the team out of rankings; set the worst value, such as the full match time for a cycle time, to rank such a team last."
          }
        }
      }
    },
    "periodFilter": {
      "description": "Count or select only actions recorded in these periods (CS-16). An action must pass every filter given; within one filter, any listed id matches.",
      "type": "object",
      "properties": {
        "phases": {
          "$ref": "#/$defs/idList",
          "description": "Phase ids from match-scouting.json, or \"preMatch\" for actions recorded before the match started."
        },
        "segments": {
          "$ref": "#/$defs/idList",
          "description": "Segment ids from match-scouting.json, such as \"transition\" or \"shift\"."
        },
        "kinds": {
          "$ref": "#/$defs/idList",
          "description": "Segment kind ids, such as \"active\" or \"inactive\": the kind the scouter selected, or a kind the configuration fixes for a whole period (#326)."
        }
      }
    }
  }
}
