{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spot.team3061.org/schema/v2/analysis-modules.schema.json",
  "title": "SPOT analysis-modules configuration (v2)",
  "description": "Dashboard widgets for the team and match views, plus Filter Teams rating bands. Built-in module options are validated strictly; extension modules accept any options. See docs/spec/09 and docs/spec/20.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "modules", "filterTeams"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 2 },
    "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } },
    "filterTeams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ratingBands"],
      "properties": {
        "ratingBands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "kind"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
              "label": { "type": "string" },
              "kind": { "enum": ["exact", "min", "range", "negative"] },
              "value": { "type": "number" },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "rating": {
                "type": "boolean",
                "description": "A band on the rating scale. Picking only rating bands shows the teams whose every positive average is at least the highest band picked; other bands show teams with any value in the band."
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$",
      "description": "Dot-separated path to a team value: what a team entry of analysis-pipeline.json writes (no leading/trailing whitespace). config:check reports a path the pipeline never writes."
    },
    "performancePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$",
      "description": "Dot-separated path to a value of each match: what a tmp entry of analysis-pipeline.json writes."
    },
    "itemPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$",
      "description": "Dot-separated path inside each item of the list another option names, such as other.pos on each action."
    },
    "actionId": {
      "type": "string",
      "minLength": 1,
      "description": "A button id from match-scouting.json (or an id from its extraActionIds). config:check reports an id that is neither."
    },
    "stat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path"],
      "properties": {
        "name": { "type": "string" },
        "path": { "$ref": "#/$defs/path" },
        "aggrMethod": { "enum": ["sum", "average"] },
        "multiplier": { "type": "number" },
        "addend": { "type": "number" },
        "decimals": { "type": "integer", "minimum": 0 },
        "unit": { "type": "string" },
        "hideIfValue": {},
        "sort": { "enum": [-1, 0, 1] }
      }
    },
    "namedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path"],
      "properties": {
        "name": { "type": "string" },
        "path": { "$ref": "#/$defs/path" },
        "aggrMethod": { "enum": ["sum", "average"] }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view", "module", "name", "options"],
      "properties": {
        "view": { "enum": ["team", "match"] },
        "module": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
        "position": { "enum": ["main", "side"] },
        "name": { "type": "string" },
        "separate": { "type": "boolean" },
        "wholeMatch": { "type": "boolean" },
        "options": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "module": { "const": "Stats" } } },
          "then": {
            "properties": {
              "options": {
                "type": "object",
                "additionalProperties": false,
                "required": ["list"],
                "properties": { "list": { "type": "array", "items": { "$ref": "#/$defs/stat" } } }
              }
            }
          }
        },
        {
          "if": { "properties": { "module": { "const": "Bar" } } },
          "then": {
            "properties": {
              "options": {
                "type": "object",
                "additionalProperties": false,
                "required": ["bars"],
                "properties": {
                  "bars": { "type": "array", "items": { "$ref": "#/$defs/namedPath" } }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "module": { "const": "Pie" } } },
          "then": {
            "properties": {
              "options": {
                "type": "object",
                "additionalProperties": false,
                "required": ["slices"],
                "properties": {
                  "slices": { "type": "array", "items": { "$ref": "#/$defs/namedPath" } },
                  "unit": { "type": "string" },
                  "decimals": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "module": { "const": "PerformanceTimePlot" } } },
          "then": {
            "properties": {
              "options": {
                "type": "object",
                "additionalProperties": false,
                "required": ["trackedStats"],
                "properties": {
                  "trackedStats": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/performancePath" }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "module": { "const": "HeatmapScatterPlot" } } },
          "then": {
            "properties": {
              "options": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "coordinatePath",
                  "aggregatedActionsPath",
                  "actionGroups",
                  "actionLabels",
                  "imgPath"
                ],
                "properties": {
                  "coordinatePath": { "$ref": "#/$defs/itemPath" },
                  "aggregatedActionsPath": { "$ref": "#/$defs/path" },
                  "actionGroups": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["name", "actions"],
                      "properties": {
                        "name": { "type": "string" },
                        "actions": { "type": "array", "items": { "$ref": "#/$defs/actionId" } },
                        "phases": {
                          "$ref": "https://spot.team3061.org/schema/v2/analysis-pipeline.schema.json#/$defs/periodFilter/properties/phases"
                        },
                        "segments": {
                          "$ref": "https://spot.team3061.org/schema/v2/analysis-pipeline.schema.json#/$defs/periodFilter/properties/segments"
                        },
                        "kinds": {
                          "$ref": "https://spot.team3061.org/schema/v2/analysis-pipeline.schema.json#/$defs/periodFilter/properties/kinds"
                        }
                      }
                    }
                  },
                  "actionLabels": {
                    "type": "object",
                    "propertyNames": { "$ref": "#/$defs/actionId" },
                    "additionalProperties": { "type": "string" }
                  },
                  "imgPath": { "type": "string" },
                  "coordinateTransform": {
                    "enum": ["none", "foldHalfField"],
                    "description": "foldHalfField reproduces 2026: both alliance zones on a half-field picture. x < 30.5 becomes (2x, y); x > 69.5 is turned round onto it, a half turn rather than a mirror, as (2(100 - x), 100 - y); 30.5 to 69.5, the neutral zone, is left out."
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "module": { "const": "RadarChart" } } },
          "then": {
            "properties": {
              "options": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sections", "lines"],
                "properties": {
                  "sections": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["name"],
                      "properties": { "name": { "type": "string" } }
                    }
                  },
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["name", "times"],
                      "properties": {
                        "name": { "type": "string" },
                        "times": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["name", "path"],
                            "properties": {
                              "name": { "type": "string" },
                              "path": {
                                "anyOf": [{ "const": "none" }, { "$ref": "#/$defs/path" }],
                                "description": "A team value, or \"none\" for 0."
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "module": { "const": "SingleDisplay" } } },
          "then": {
            "properties": {
              "options": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": { "$ref": "#/$defs/path" },
                  "aggrMethod": { "enum": ["sum", "average", "percentChanceOfWinning"] },
                  "decimals": { "type": "integer", "minimum": 0 },
                  "unit": { "type": "string" },
                  "multiplier": { "type": "number" },
                  "addend": { "type": "number" },
                  "hideIfValue": {}
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "module": { "const": "ColumnDisplay" } } },
          "then": {
            "properties": {
              "options": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path"],
                "properties": {
                  "path": { "$ref": "#/$defs/path" },
                  "sort": { "enum": [-1, 0, 1] },
                  "decimals": { "type": "integer", "minimum": 0 },
                  "unit": { "type": "string" },
                  "multiplier": { "type": "number" },
                  "addend": { "type": "number" },
                  "hideIfValue": {},
                  "string": { "type": "boolean" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "module": { "const": "Grid" } } },
          "then": {
            "properties": {
              "options": {
                "type": "object",
                "additionalProperties": false,
                "required": ["rows", "cols", "cells"],
                "properties": {
                  "rows": { "type": "integer" },
                  "cols": { "type": "integer" },
                  "decimals": { "type": "integer" },
                  "min": { "type": "number" },
                  "max": { "type": "number" },
                  "cells": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["x", "y", "path", "hex"],
                      "properties": {
                        "x": { "type": "integer" },
                        "y": { "type": "integer" },
                        "path": { "$ref": "#/$defs/path" },
                        "hex": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "module": { "const": "Divider" } } },
          "then": {
            "properties": { "options": { "type": "object", "additionalProperties": false } }
          }
        }
      ]
    }
  }
}
